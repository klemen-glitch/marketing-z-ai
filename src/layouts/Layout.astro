---
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import serifLatin from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import serifExt from '@fontsource/instrument-serif/files/instrument-serif-latin-ext-400-normal.woff2?url';
import serifItalic from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import sansLatin from '@fontsource/instrument-sans/files/instrument-sans-latin-400-normal.woff2?url';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: string;
  noindex?: boolean;
}

const {
  title = 'Marketing z AI',
  description = 'Klemen Lorber — performance marketing in AI agenti za slovenska podjetja. Meta oglaševanje, Google Ads, CRM integracije, AI avtomatizacija. 11 let izkušenj.',
  image = '/og-image.svg',
  canonical = Astro.url.href,
  type = 'website',
  noindex = false,
} = Astro.props;

const siteUrl = 'https://www.marketingzai.eu';
const fullTitle = title === 'Marketing z AI' ? title : `${title} | Marketing z AI`;
const fullImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
---

<!DOCTYPE html>
<html lang="sl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Klemen Lorber" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="theme-color" content="#0e0d0b" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="sl" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifExt} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifItalic} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:alt" content="Marketing z AI – Klemen Lorber" />
    <meta property="og:locale" content="sl_SI" />
    <meta property="og:site_name" content="Marketing z AI" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImage} />

    <meta name="keywords" content="performance marketing, AI agenti, Meta oglaševanje, Google Ads, CRM integracije, AI avtomatizacija, lead generation, Klemen Lorber, Slovenija, digitalni marketing" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Person",
            "@id": "https://www.marketingzai.eu/#klemen",
            "name": "Klemen Lorber",
            "jobTitle": "Performance Marketing & AI Specialist",
            "description": "Vodilni slovenski performance marketing in AI avtonomije strokovnjak z 11+ leti izkušenj.",
            "url": "https://www.marketingzai.eu",
            "email": "klemenlor@gmail.com",
            "telephone": "+38640352112",
            "address": {
              "@type": "PostalAddress",
              "addressLocality": "Ljubljana",
              "addressCountry": "SI"
            },
            "knowsAbout": ["Meta Advertising", "Google Ads", "CRM Integration", "AI Automation", "Performance Marketing"]
          },
          {
            "@type": "ProfessionalService",
            "@id": "https://www.marketingzai.eu/#business",
            "name": "Marketing z AI",
            "alternateName": "Klemen Lorber s.p.",
            "description": "Performance marketing in AI rešitve za slovensko podjetja. Meta oglaševanje, Google Ads, CRM integracije, AI agenti.",
            "url": "https://www.marketingzai.eu",
            "telephone": "+38640352112",
            "email": "klemenlor@gmail.com",
            "founder": { "@id": "https://www.marketingzai.eu/#klemen" },
            "foundingDate": "2017",
            "areaServed": ["SI", "EU"],
            "address": {
              "@type": "PostalAddress",
              "addressLocality": "Ljubljana",
              "addressCountry": "SI"
            },
            "priceRange": "€€",
            "hasOfferCatalog": {
              "@type": "OfferCatalog",
              "name": "Storitve digitalnega marketinga",
              "itemListElement": [
                { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Meta Lead Generation", "description": "Facebook in Instagram oglaševanje za pridobivanje leadov" } },
                { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Google Ads", "description": "Search in Performance Max kampanje" } },
                { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "CRM Integracije", "description": "Implementacija in integracija CRM sistemov" } },
                { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "AI Agenti", "description": "Avtonomni AI agenti za marketing in podporo" } }
              ]
            },
            "sameAs": [
              "https://www.linkedin.com/in/klemen-lorber"
            ]
          },
          {
            "@type": "WebSite",
            "@id": "https://www.marketingzai.eu/#website",
            "url": "https://www.marketingzai.eu",
            "name": "Marketing z AI",
            "description": "Performance marketing in AI rešitve",
            "publisher": { "@id": "https://www.marketingzai.eu/#business" },
            "inLanguage": "sl-SI",
            "potentialAction": {
              "@type": "SearchAction",
              "target": "https://www.marketingzai.eu/?s={search_term_string}",
              "query-input": "required name=search_term_string"
            }
          }
        ]
      }
    </script>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      "url": canonical,
      "name": fullTitle,
      "description": description,
      "isPartOf": { "@id": "https://www.marketingzai.eu/#website" },
      "about": { "@id": "https://www.marketingzai.eu/#business" },
      "inLanguage": "sl-SI"
    })}></script>

    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <script is:inline>
      (function () {
        try {
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.classList.add('is-motion');
          }
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <div class="grain" aria-hidden="true"></div>
    <div class="progress" aria-hidden="true"><span></span></div>
    <a class="skip" href="#main">Preskoči na vsebino</a>
    <div class="page">
      <slot />
    </div>
    <CookieBanner />
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
