---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 – Stran ni najdena"
  description="Stran, ki jo iščete, ne obstaja. Vrnite se na marketingzai.eu"
>
  <main id="main" class="missing theme-dark" tabindex="-1">
    <div>
      <p class="missing-num" data-text="404">404</p>
      <h1>Ta stran ne obstaja</h1>
      <p>
        Morda je bila stran premaknjena, izbrisana ali ste vtipkali napačen naslov.
        Naši AI agenti jo iščejo, a zaenkrat brez uspeha.
      </p>
      <div class="missing-actions">
        <a href="/" class="btn btn-signal">← Nazaj na začetek</a>
        <a href="/#kontakt" class="btn btn-ghost">Kontaktiraj nas</a>
      </div>
      <p class="missing-brand">Marketing z AI · marketingzai.eu</p>
    </div>
  </main>
</Layout>
