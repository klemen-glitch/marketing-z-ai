---
---

<section id="hero" class="hero theme-dark" aria-label="Uvod">
  <div class="wrap hero-main">
    <div>
      <p class="badge">🚀 Prihodnost marketinga je tu</p>
      <p class="chapter">01 — Uvod</p>
      <h1 class="hero-title">
        <span class="line"><span class="word">AI</span> <span class="word">Agenti</span></span>
        <span class="line"><span class="word">kot</span> <span class="word">vaš</span></span>
        <span class="line"><span class="word">marketing</span></span>
        <span class="line"><span class="word word-em">partner</span></span>
      </h1>
    </div>

    <div class="hero-aside">
      <div class="orb" aria-hidden="true">
        <div class="orb-ring"></div>
        <div class="orb-spin"></div>
        <div class="orb-cross"></div>
      </div>
      <p class="lede" data-split>
        Povezovalna moč med ljudmi in umetno inteligenco. Skupaj rastemo hitrejše, pametnejše in bolj učinkovito.
      </p>
      <div class="cta-row">
        <a href="#storitve" class="btn btn-signal">Spoznaj storitve</a>
        <a href="#kontakt" class="btn btn-ghost">Brezplačna konzultacija</a>
      </div>
    </div>
  </div>

  <div class="wrap hero-stats" data-reveal>
    <div>
      <p class="stat-num">1 + 6</p>
      <p class="stat-label">Strokovnjak &amp; AI agenti</p>
    </div>
    <div>
      <p class="stat-num">771%</p>
      <p class="stat-label">ROI za integracije</p>
    </div>
    <div>
      <p class="stat-num">11 let</p>
      <p class="stat-label">Izkušenj v branži</p>
    </div>
  </div>
</section>
