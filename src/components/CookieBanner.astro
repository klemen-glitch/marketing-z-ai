---
---

<div id="cookie-banner" class="cookie" hidden>
  <div class="cookie-panel">
    <div class="cookie-row">
      <div>
        <div class="cookie-kicker">
          <span aria-hidden="true">🍪</span>
          <h2>Nastavitve piškotkov</h2>
          <span class="gdpr">GDPR</span>
        </div>
        <p>
          Uporabljamo <strong>nujne piškotke</strong> (tehnično delovanje) in — z vašo privolitvijo — <strong>analitične piškotke</strong> (Google Analytics za izboljšanje strani). Vaša privolitev je prostovoljna in jo kadar koli prekličete.
          <a href="/privacy-policy#piškotki">Več o piškotkih →</a>
        </p>
      </div>

      <div class="cookie-actions">
        <button id="cookie-reject" class="btn btn-ghost" type="button">Zavrni neobvezne</button>
        <button id="cookie-settings" class="btn btn-ghost" type="button">Nastavitve</button>
        <button id="cookie-accept" class="btn btn-signal" type="button">Sprejmi vse</button>
      </div>
    </div>

    <div id="cookie-details" class="cookie-details" hidden>
      <p class="micro">Upravljanje kategorij piškotkov:</p>
      <div class="cookie-cats">
        <div class="cookie-cat">
          <div class="toggle-locked" aria-hidden="true"><i></i></div>
          <div>
            <p>Nujni piškotki</p>
            <p class="sub">Vedno aktivni — tehnično delovanje</p>
          </div>
        </div>

        <div class="cookie-cat">
          <button
            id="toggle-analytics"
            class="toggle"
            type="button"
            data-active="false"
            aria-label="Vklop/izklop analitičnih piškotkov"
          >
            <i id="toggle-knob"></i>
          </button>
          <div>
            <p>Analitični piškotki</p>
            <p class="sub">Google Analytics — statistika obiskov</p>
          </div>
        </div>
      </div>

      <button id="cookie-save-settings" class="btn btn-signal" type="button" style="margin-top:0.9rem">
        Shrani nastavitve
      </button>
    </div>
  </div>
</div>

<script>
  const COOKIE_KEY = 'mzai_cookie_consent';
  const banner = document.getElementById('cookie-banner');
  const detailsPanel = document.getElementById('cookie-details');
  const toggle = document.getElementById('toggle-analytics');

  const stored = localStorage.getItem(COOKIE_KEY);
  if (!stored) {
    setTimeout(() => { if (banner) banner.hidden = false; }, 800);
  } else {
    const consent = JSON.parse(stored);
    if (consent.analytics) loadAnalytics();
  }

  document.getElementById('cookie-accept')?.addEventListener('click', () => {
    saveConsent({ necessary: true, analytics: true });
    loadAnalytics();
    hideBanner();
  });

  document.getElementById('cookie-reject')?.addEventListener('click', () => {
    saveConsent({ necessary: true, analytics: false });
    hideBanner();
  });

  document.getElementById('cookie-settings')?.addEventListener('click', () => {
    if (!detailsPanel) return;
    detailsPanel.hidden = !detailsPanel.hidden;
  });

  let analyticsEnabled = false;
  toggle?.addEventListener('click', () => {
    analyticsEnabled = !analyticsEnabled;
    toggle.dataset.active = String(analyticsEnabled);
  });

  document.getElementById('cookie-save-settings')?.addEventListener('click', () => {
    saveConsent({ necessary: true, analytics: analyticsEnabled });
    if (analyticsEnabled) loadAnalytics();
    hideBanner();
  });

  function saveConsent(consent: { necessary: boolean; analytics: boolean }) {
    localStorage.setItem(COOKIE_KEY, JSON.stringify({
      ...consent,
      timestamp: new Date().toISOString()
    }));
  }

  function hideBanner() {
    if (banner) banner.hidden = true;
  }

  function loadAnalytics() {
    console.log('Analytics enabled (dodajte GA4 ID)');
  }
</script>
