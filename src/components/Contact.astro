---
---

<section id="kontakt" class="contact theme-light" aria-label="Kontakt">
  <div class="wrap contact-grid">
    <div class="contact-copy">
      <p class="chapter">06 — Kontakt</p>
      <h2 class="display display-m" data-split>Pokličimo za brezplačno konzultacijo</h2>
      <p class="lede-sm" data-split>
        Razgovarjajmo o vašem trenutnem stanju in kako vam lahko pomagamo doseči vaše cilje z AI in avtomatizacijo.
      </p>

      <ul class="contact-points">
        <li>
          <span aria-hidden="true">📧</span>
          <div>
            <strong>Email</strong>
            <a href="mailto:klemenlor@gmail.com">klemenlor@gmail.com</a>
          </div>
        </li>
        <li>
          <span aria-hidden="true">📱</span>
          <div>
            <strong>Telefon</strong>
            <a href="tel:+38640352112">040 352 112</a>
          </div>
        </li>
        <li>
          <span aria-hidden="true">📍</span>
          <div>
            <strong>Lokacija</strong>
            <span>Ljubljana, Slovenija</span>
          </div>
        </li>
      </ul>
    </div>

    <form
      name="kontakt"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      id="contact-form"
      class="contact-form theme-dark"
    >
      <input type="hidden" name="form-name" value="kontakt" />
      <p class="hidden"><input name="bot-field" /></p>

      <div class="field">
        <label for="ime">Ime in Priimek <span class="req">*</span></label>
        <input
          type="text"
          id="ime"
          name="ime"
          required
          autocomplete="name"
          placeholder="Vaše ime"
        />
      </div>

      <div class="field">
        <label for="email">Email <span class="req">*</span></label>
        <input
          type="email"
          id="email"
          name="email"
          required
          autocomplete="email"
          placeholder="vas@email.com"
        />
      </div>

      <div class="field">
        <label for="podjetje">Podjetje</label>
        <input
          type="text"
          id="podjetje"
          name="podjetje"
          autocomplete="organization"
          placeholder="Ime podjetja"
        />
      </div>

      <div class="field">
        <label for="sporocilo">Vaše sporočilo <span class="req">*</span></label>
        <textarea
          id="sporocilo"
          name="sporocilo"
          required
          placeholder="Povejte nam, s čim se ukvarjate in kako vam lahko pomagamo..."
          rows="4"
        ></textarea>
      </div>

      <div id="form-success" class="form-success hidden">
        ✅ Sporočilo poslano! Odgovorili bomo v 24 urah.
      </div>

      <button type="submit" id="submit-btn" class="btn btn-signal">
        Pošlji povpraševanje →
      </button>
      <p class="form-note">Z oddajo se strinjate z našo <a href="/privacy-policy">politiko zasebnosti</a>.</p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMsg = document.getElementById('form-success');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.textContent = 'Pošiljam...';
    submitBtn.disabled = true;

    try {
      const formData = new FormData(form);
      const response = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(formData as any).toString(),
      });

      if (response.ok) {
        successMsg?.classList.remove('hidden');
        form.reset();
        submitBtn.textContent = '✅ Poslano!';
      } else {
        submitBtn.textContent = 'Pošlji povpraševanje →';
        submitBtn.disabled = false;
      }
    } catch {
      submitBtn.textContent = 'Pošlji povpraševanje →';
      submitBtn.disabled = false;
    }
  });
</script>
