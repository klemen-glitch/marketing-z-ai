---
const faqs = [
  {
    q: "Kako zagotovite GDPR skladnost pri FB lead generation?",
    a: "Vsi procesi so zasnovani v skladu s predpisi: podatki se shranjujejo v varnih bazah s pravicami dostopa. Vsak lead je sledljiv s polnim audit trail."
  },
  {
    q: "Katera orodja za AI-poročanje priporočate?",
    a: "Priporočamo kombinacijo Lyzr za narativne povzetke in Google Data Studio za interaktivne dashboards. Izbira je odvisna od vaših potreb."
  },
  {
    q: "Kako dolgo traja CRM implementacija?",
    a: "Osnovana implementacija traja 1-2 meseca za manjša podjetja. Obsežne arhitekture s 5-plastno integracijo lahko trajajo 3-6 mesecev."
  },
  {
    q: "Ali je mogoče AI-agente skalirati za večje količine?",
    a: "Absolutno. Naši sistemi so zasnovani za skalabilnost. Od 100 do milijona zahtevkov - arhitektura se prilagaja vašim potrebam."
  },
  {
    q: "Kaj se zgodi z mojimi podatki, če prekinemo sodelovanje?",
    a: "Vsi vaši podatki ostanejo v vaši lasti. Zagotovimo vam celovit izvoz in prehod v druge sisteme. Ničesar ne zadržujemo."
  },
  {
    q: "Ponujate 24/7 tehnično podporo?",
    a: "Da. Za enterprise naročnike je 24/7 podpora standardna. Za manjše pakete nudimo business hours podporo s hitrim odzivom."
  }
];
---

<section id="faq" class="faq theme-dark" aria-label="Pogosta vprašanja">
  <div class="wrap">
    <div class="faq-head">
      <p class="chapter">05 — Vprašanja</p>
      <h2 class="display display-l" data-split>Pogosta Vprašanja</h2>
      <p class="lede-sm" data-split>Odgovori na najpogostejša vprašanja naših strank.</p>
    </div>

    <div data-reveal>
      {faqs.map((faq) => (
        <details class="faq-item">
          <summary>
            <span>{faq.q}</span>
            <span class="faq-chevron" aria-hidden="true"></span>
          </summary>
          <p class="answer">{faq.a}</p>
        </details>
      ))}
    </div>

    <div class="faq-help">
      <h3>Imate dodatno vprašanje?</h3>
      <p>Naš team je tu za vas.</p>
      <a href="#kontakt" class="btn btn-signal">Kontaktirajte nas</a>
    </div>
  </div>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Kako zagotovite GDPR skladnost pri FB lead generation?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Vsi procesi so zasnovani v skladu s predpisi: podatki se shranjujejo v varnih bazah s pravicami dostopa. Vsak lead je sledljiv s polnim audit trail."
        }
      },
      {
        "@type": "Question",
        "name": "Katera orodja za AI-poročanje priporočate?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Priporočamo kombinacijo Lyzr za narativne povzetke in Google Data Studio za interaktivne dashboards. Izbira je odvisna od vaših potreb."
        }
      },
      {
        "@type": "Question",
        "name": "Kako dolgo traja CRM implementacija?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Osnovna implementacija traja 1-2 meseca za manjša podjetja. Obsežne arhitekture s 5-plastno integracijo lahko trajajo 3-6 mesecev."
        }
      },
      {
        "@type": "Question",
        "name": "Ali je mogoče AI-agente skalirati za večje količine?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Absolutno. Naši sistemi so zasnovani za skalabilnost. Od 100 do milijona zahtevkov - arhitektura se prilagaja vašim potrebam."
        }
      },
      {
        "@type": "Question",
        "name": "Kaj se zgodi z mojimi podatki, če prekinemo sodelovanje?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Vsi vaši podatki ostanejo v vaši lasti. Zagotovimo vam celovit izvoz in prehod v druge sisteme. Ničesar ne zadržujemo."
        }
      },
      {
        "@type": "Question",
        "name": "Ponujate 24/7 tehnično podporo?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Da. Za enterprise naročnike je 24/7 podpora standardna. Za manjše pakete nudimo business hours podporo s hitrim odzivom."
        }
      }
    ]
  }
</script>
